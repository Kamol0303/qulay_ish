{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "SKIP_API=1 vite --port=3000 --host=0.0.0.0",
    "dev:web-only": "SKIP_API=1 vite --port=3000 --host=0.0.0.0",
    "dev:stack": "bash scripts/dev.sh",
    "build": "vite build",
    "env:write": "bash scripts/write-local-envs.sh",
    "otp:check": "bash scripts/check-otp.sh",
    "build:apk": "vite build --mode capacitor && npx cap sync android",
    "build:ios": "vite build --mode capacitor && npx cap sync ios",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:all": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "apk:debug": "npm run build:apk && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run build:apk && cd android && ./gradlew assembleRelease",
    "ios:sync": "bash scripts/build-ios.sh sync",
    "ios:open": "bash scripts/build-ios.sh open",
    "ios:archive": "bash scripts/build-ios.sh archive",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:setup": "bash scripts/setup-db.sh",
    "db:up": "bash scripts/setup-db.sh",
    "db:down": "sh -c 'docker compose down 2>/dev/null || docker-compose down 2>/dev/null || true'",
    "api:install": "cd api && npm install && npx prisma migrate deploy && npx prisma generate",
    "api:dev": "cd api && npm run start:dev",
    "api:build": "cd api && npm run build",
    "db:migrate": "cd api && npx prisma migrate deploy",
    "db:seed": "cd api && npm run prisma:seed"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
