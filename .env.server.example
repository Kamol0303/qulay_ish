# ============================================================
# Mehrli qoʻllar — SERVER (Docker) sozlamalari
# ============================================================
# Serverda shu faylni `.env` deb nusxalang va qiymatlarni to'ldiring:
#     cp .env.server.example .env
# Keyin ishga tushiring:
#     docker compose up -d --build
# Boshqa hech qanday sozlash shart emas.
# ------------------------------------------------------------

# --- Ma'lumotlar bazasi (ichki, konteynerlar orasida) ---
POSTGRES_USER=qulay_ish
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=qulay_ish

# --- Backend (API) ---
# Kuchli tasodifiy kalit: `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_random_64_hex
# Mobil ilovada qayta login so'ralmasligi uchun uzun muddat
JWT_EXPIRES_IN=180d
# Sayt domeningiz (bir nechta bo'lsa vergul bilan)
CORS_ORIGIN=https://example.uz,https://www.example.uz

# --- Super Admin ---
SUPER_ADMIN_EMAIL=superadmin@example.uz
SUPER_ADMIN_PASSWORD=CHANGE_ME_admin_password
SUPER_ADMIN_PHONE=+998900000000

# --- SMS (DevSMS) — OTP shu orqali yuboriladi ---
DEVSMS_TOKEN=CHANGE_ME_devsms_token
DEVSMS_BASE_URL=https://devsms.uz/api
DEVSMS_SERVICE_NAME=Mehrli Qollar
DEVSMS_FROM=4546
DEVSMS_DEV_MODE=false

# --- To'lov / obuna ---
PAYMENT_CARD_NUMBER=0000000000000000
OWNER_OTP_PHONE=+998900000000
# Bo'sh qoldiring — narx har oy 250000..450000 oralig'ida avtomatik o'zgaradi
SUBSCRIPTION_PRICE=

# --- AI (ixtiyoriy; bo'sh bo'lsa mock rejim) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VITE_AI_MOCK_MODE=true

# --- Web (nginx tashqi port) ---
WEB_PORT=80

# --- Frontendga build vaqtida kiradigan Super Admin ma'lumotlari ---
VITE_SUPER_ADMIN_PHONE=+998900000000
VITE_SUPER_ADMIN_PASSWORD=CHANGE_ME_admin_password
VITE_SUPER_ADMIN_EMAIL=superadmin@example.uz
