# Copy to api/.env — hech qachon gitga commit qilinmasin
# cp api/.env.example api/.env

DATABASE_URL=postgresql://qulay_ish:qulay_ish_dev@localhost:5432/qulay_ish
JWT_SECRET=change-me-in-production-use-long-random
JWT_EXPIRES_IN=7d
API_PORT=4000

# Website + Capacitor WebView origins (Nest ham default merge qiladi)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://ishliayol.uz,https://www.ishliayol.uz,https://localhost,capacitor://localhost

SUPER_ADMIN_EMAIL=superadmin@ishliayol.uz
SUPER_ADMIN_PHONE=+998900707081
SUPER_ADMIN_PASSWORD=change-me

# --- DevSMS OTP (APK/sayt register uchun MAJBURIY) ---
# Token faqat shu api/.env da — ildizdagi .env da EMAS
DEVSMS_TOKEN=
DEVSMS_BASE_URL=https://devsms.uz/api
# Universal OTP service_name (apostrof bo'lmasin: Qo'llar → Qollar)
DEVSMS_SERVICE_NAME=Mexrli Qollar
# true = SMS o'rniga server logida [DEV OTP] (faqat local)
DEVSMS_DEV_MODE=false
