# Capacitor / Android APK + iOS production build — absolute API (same backend as the website)
VITE_API_URL=https://ishliayol.uz/api
VITE_APP_URL=https://ishliayol.uz
VITE_AI_MOCK_MODE=false
VITE_USE_EMULATOR=false

# Optional: super-admin credentials for debug builds only (do NOT ship secrets in release builds)
# VITE_SUPER_ADMIN_PHONE=+998900707081
# VITE_SUPER_ADMIN_PASSWORD=your_password
# VITE_SUPER_ADMIN_EMAIL=superadmin@ishliayol.uz

# If you plan to build a signed release APK, create a non-committed `key.properties` at repository root
# from `key.properties.example` and set Android keystore values there. The repo's .gitignore
# already excludes `key.properties` and keystore files.

