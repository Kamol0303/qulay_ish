# Frontend production build (Vite) — ishliayol.uz
# Copy to .env.production before `npm run build`

# Same-origin API via nginx reverse proxy (recommended)
VITE_API_URL=/api

# Or absolute API URL:
# VITE_API_URL=https://ishliayol.uz/api

VITE_APP_URL=https://ishliayol.uz
VITE_PUBLIC_SITE_URL=https://ishliayol.uz

VITE_SUPER_ADMIN_PHONE=+998900707081
VITE_SUPER_ADMIN_PASSWORD=
VITE_SUPER_ADMIN_EMAIL=superadmin@ishliayol.uz

VITE_USE_EMULATOR=false
VITE_AI_MOCK_MODE=false
